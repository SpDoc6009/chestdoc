generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  sortOrder     Int           @default(0)
  subcategories Subcategory[]
  articles      Article[]
  htmlReports   HtmlReport[]
  pdfDocuments  PdfDocument[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id           String        @id @default(cuid())
  name         String
  slug         String
  description  String?
  sortOrder    Int           @default(0)
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  articles     Article[]
  htmlReports  HtmlReport[]
  pdfDocuments PdfDocument[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Article {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  summary       String
  content       String
  htmlContent   String?
  keywords      String[]     @default([])
  categoryId    String?
  subcategoryId String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  isPublished   Boolean      @default(false)
  isFeatured    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isPublished, createdAt])
}

model HtmlReport {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  summary         String
  htmlContent     String
  markdownContent String?
  keywords        String[]     @default([])
  categoryId      String?
  subcategoryId   String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  isPublished     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isPublished, createdAt])
}

model PdfDocument {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String?
  fileUrl       String
  fileName      String
  fileSize      Int
  keywords      String[]     @default([])
  categoryId    String?
  subcategoryId String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  isPublished   Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isPublished, createdAt])
}

model UsefulLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  group       String   @default("一般")
  isFavorite  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group, sortOrder])
}

model ContentView {
  id          String   @id @default(cuid())
  contentType String
  contentId   String
  title       String
  path        String
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contentType, contentId])
  @@index([contentType])
  @@index([viewCount])
}

model TeachingTopic {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String?
  sortOrder   Int              @default(0)
  lessons     TeachingLesson[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TeachingLesson {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  summary         String
  contentMode     TeachingContentMode @default(MARKDOWN)
  markdownContent String?
  htmlContent     String?
  keywords        String[]            @default([])
  topicId         String
  topic           TeachingTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  isPublished     Boolean             @default(false)
  isFeatured      Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([topicId])
  @@index([isPublished, updatedAt])
}

enum TeachingContentMode {
  MARKDOWN
  HTML
}
